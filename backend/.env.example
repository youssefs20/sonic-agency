PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sonic_db?sslmode=disable
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXIES=

# Contact form notification email (Gmail SMTP).
# SMTP_USER is the Gmail address that SENDS the notification.
# SMTP_PASSWORD is a 16-character Gmail "App Password" — NOT your real
# Gmail password. Generate one at: Google Account > Security >
# 2-Step Verification > App Passwords (requires 2-Step Verification enabled).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_RECIPIENT_EMAIL=yousef17453@gmail.com
