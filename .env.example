# Copy to `.env` next to docker-compose.yml and fill in before
# `docker compose up`. Never commit the real `.env`.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=            # REQUIRED — pick a long random password
POSTGRES_DB=sonic_db

# --- Backend ---
# Public origin(s) of the site, comma-separated. With nginx in front this
# is your domain, e.g. https://sonicagency.com
ALLOWED_ORIGINS=http://localhost
# Proxy range allowed to set X-Forwarded-For (default fits Docker networks)
TRUSTED_PROXIES=172.16.0.0/12

# --- Contact form email (Gmail SMTP) ---
# SMTP_PASSWORD is a Gmail App Password (Google Account > Security >
# 2-Step Verification > App Passwords), NOT the real account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_RECIPIENT_EMAIL=

# --- Frontend (BUILD-time value, baked into the browser bundle) ---
# Public URL the browser should call for the API. With nginx proxying
# /api on the same domain: https://sonicagency.com
# Leave empty for demo mode (no backend).
NEXT_PUBLIC_API_URL=
